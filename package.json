{
  "name": "kovanica-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "kovanicaSdk": {
    "repository": "https://github.com/KovanicaDAG/kovanica-sdk",
    "testedRevision": "b36d63b04af9483cce96647071f1e3de8c143231"
  },
  "scripts": {
    "prepare:sdk": "node scripts/prepare-sdk.mjs",
    "dev": "node scripts/prepare-sdk.mjs && vite",
    "build": "node scripts/prepare-sdk.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/prepare-sdk.mjs && tsc --noEmit",
    "lint": "node scripts/prepare-sdk.mjs && tsc --noEmit",
    "test": "node scripts/prepare-sdk.mjs && vitest run",
    "test:browser": "node scripts/prepare-sdk.mjs && vitest run tests/browser-rpc.test.ts",
    "test:browser:live": "node scripts/prepare-sdk.mjs && vitest run tests/browser-live.test.ts",
    "test:browser:live:required": "node scripts/prepare-sdk.mjs && KOVANICA_REQUIRE_LIVE=1 vitest run tests/browser-live.test.ts",
    "test:live": "node scripts/prepare-sdk.mjs && vitest run tests/live-node.test.ts",
    "test:live:required": "node scripts/prepare-sdk.mjs && KOVANICA_REQUIRE_LIVE=1 vitest run tests/live-node.test.ts"
  },
  "dependencies": {
    "kovanica-sdk": "file:../kovanica-sdk",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "playwright": "~1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
